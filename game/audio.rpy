## audio.rpy — music and sound effects.
##
## Music follows the background automatically: whenever a new background is on
## screen, the matching track fades in (if it isn't already playing). To change
## which track plays where, edit BG_MUSIC. A scene can force a track by setting
## `music_mood` (for example the romance endings set it to "tender"); set it back
## to None to return to automatic.
##
## The files in game/audio/ are generated by tools/make_audio.py. To use real
## music instead, replace them with files of the same name (OGG or OPUS).

define MUSIC = {
    "theme": "audio/theme.ogg",
    "day": "audio/day.ogg",
    "night": "audio/night.ogg",
    "party": "audio/party.ogg",
    "tender": "audio/tender.ogg",
}

define BG_MUSIC = {
    "exterior": "day", "lobby": "day", "pool": "day", "bedroom": "day",
    "ballroom": "party", "ballroom_ark": "party",
    "roof": "tender", "roof_dawn": "tender", "ship": "tender",
    # Everything else (the hallways and every art room) is "night".
}

define config.main_menu_music = "audio/theme.ogg"
define config.fadeout_audio = 1.0

define audio.click = "audio/sfx/click.ogg"
define audio.rapport_up = "audio/sfx/rapport_up.ogg"
define audio.rapport_down = "audio/sfx/rapport_down.ogg"
define audio.whoosh = "audio/sfx/whoosh.ogg"
define audio.ark = "audio/sfx/ark.ogg"

default music_mood = None
default music_silenced = False

init python:

    def _current_bg():
        try:
            attrs = renpy.get_attributes("bg")
        except Exception:
            attrs = None
        return attrs[0] if attrs else None

    def _wanted_track():
        if store.music_silenced:
            return None
        if store.music_mood:
            return MUSIC[store.music_mood]
        bg = _current_bg()
        if bg is None:
            return "keep"
        return MUSIC[BG_MUSIC.get(bg, "night")]

    # The track we last asked for. Browsers can report nothing playing until
    # the player first clicks, so this stops us restarting the track on every
    # line while we wait.
    _music_requested = [None]

    def _music_follow_scene():
        if store.main_menu or store._menu:
            _music_requested[0] = None
            return
        want = _wanted_track()
        if want == "keep":
            return
        playing = renpy.music.get_playing("music")
        if want is None:
            if playing or _music_requested[0]:
                renpy.music.stop("music", fadeout=1.5)
            _music_requested[0] = None
        elif playing != want and _music_requested[0] != want:
            renpy.music.play(want, channel="music", loop=True, fadein=1.5, fadeout=1.5)
            _music_requested[0] = want
        elif playing == want:
            _music_requested[0] = want

    config.start_interact_callbacks.append(_music_follow_scene)


## Choices click when picked.
style choice_button:
    activate_sound "audio/sfx/click.ogg"
